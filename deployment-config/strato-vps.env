# Copy this file on Strato VPS and replace values.

APP_ENV=production
NODE_ENV=production
PORT=3000

POSTGRES_DB=pension_pal
POSTGRES_USER=pension_pal
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://pension_pal:replace_me@db:5432/pension_pal

SECRET_KEY=replace_with_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

MISTRAL_API_KEY=replace_with_your_mistral_api_key

DOCKER_REGISTRY=ghcr.io/doebele/pension-pal
IMAGE_TAG=latest

PUBLIC_DOMAIN=pensionpal.doebele12.de
APP_BIND_IP=127.0.0.1
APP_HTTP_PORT=18080
